{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"$CLAUDE_PROJECT_DIR/.claude/hooks/tickets/prompt_guard.py\" || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"$CLAUDE_PROJECT_DIR/.claude/hooks/tickets/write_guard.py\" || exit 0",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"$CLAUDE_PROJECT_DIR/.claude/hooks/tickets/shell_guard.py\" || exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
